  "sections": {
    "hero": {
      "id": "hero-1",
      "title": "قيادة توزيع موثوق",
      "subtitle": "في جميع أنحاء المملكة العربية السعودية لمدة 20 عامًا وما بعدها.",
      "yearText": "",
      "scrollText": "انتقل للأسفل",
      "createdAt": "2025-08-12T15:01:20.732Z",
      "updatedAt": "2025-08-13T15:22:21.599Z"
    },
    "truck_reveal": {
      "content": "لأكثر من 32 عامًا، كانت شركة السلامة للنقل (AST) شريكًا موثوقًا في نقل البضائع والمواد في جميع أنحاء المملكة العربية السعودية وخارجها. ومن خلال خدمات التوزيع على مستوى المملكة وصولًا إلى حلول النقل المتخصصة، تجمع AST بين أسطول حديث، تخطيط لوجستي متقدم، ونهج يضع العميل في المقام الأول لضمان أن كل عملية تسليم تلبّي أعلى معايير السرعة والموثوقية والسلامة. وبفضل مراكز تشغيلية موزعة في مواقع استراتيجية وفريق من الكفاءات المهنية عالية التدريب، تدعم AST قطاعات متعددة من السلع الاستهلاكية سريعة التداول (FMCG) إلى السلع الصناعية، خادمةً بذلك الشركات المحلية والمؤسسات متعددة الجنسيات على حد سواء. ويستند نجاحنا إلى معرفة عميقة بالسوق، وكفاءة تشغيلية عالية، وعلاقات طويلة الأمد مع العملاء صمدت أمام اختبار الزمن."
    },
    "truck_rotation": {
      "id": "truck-rotation-1",
      "sections": [
        {
          "number": "01",
          "title": "رؤيتنا",
          "subtitle": "رؤيتنا",
          "content": "أن نكون الشريك الأكثر موثوقية وابتكارًا في مجال النقل في المملكة العربية السعودية، معترفًا بنا للتميّز التشغيلي، والتقدّم التكنولوجي، والالتزام الراسخ بالجودة",
          "main": [
            {
              "text": "أن نكون الشريك الأكثر موثوقية وابتكارًا في مجال النقل في المملكة العربية السعودية",
              "color": "#273d97"
            }
          ],
          "caption": "معترفًا بنا للتميّز التشغيلي، والتقدّم التكنولوجي، والالتزام الراسخ بالجودة"
        },
        {
          "number": "02",
          "title": "مهمتنا",
          "subtitle": "مهمتنا",
          "content": "تقديم خدمات نقل وتوزيع موثوقة. تمكين الأعمال، وتعزيز سلاسل الإمداد، وربط المجتمعات في جميع أنحاء المملكة العربية السعودية والمنطقة — مع الالتزام بالتسليم في الوقت المحدد، في كل مرة",
          "main": [
            {
              "text": "تقديم خدمات نقل وتوزيع موثوقة",
              "color": "#273d97"
            }
          ],
          "caption": "تمكين الأعمال، وتعزيز سلاسل الإمداد، وربط المجتمعات في جميع أنحاء المملكة العربية السعودية والمنطقة — مع الالتزام بالتسليم في الوقت المحدد، في كل مرة"
        },
        {
          "number": "03",
          "title": "إلتزامنا",
          "subtitle": "إلتزامنا",
          "content": "الموثوقية والسلامة ليستا مجرد وعود، بل هما مبادئنا التشغيلية. نستثمر في أسطول حديث يتمتع بصيانة عالية ومجهّز بتقنيات التتبع في الوقت الفعلي، مما يضمن جداول تسليم يمكن التنبؤ بها وتواصلًا شفافًا",
          "main": [
            {
              "text": "الموثوقية والسلامة ليستا مجرد وعود، بل هما مبادئنا التشغيلية",
              "color": "#273d97"
            }
          ],
          "caption": "نستثمر في أسطول حديث يتمتع بصيانة عالية ومجهّز بتقنيات التتبع في الوقت الفعلي، مما يضمن جداول تسليم يمكن التنبؤ بها وتواصلًا شفافًا"
        }
      ],
      "createdAt": "2025-08-12T15:02:06.280Z",
      "updatedAt": "2025-08-12T15:02:06.280Z"
    },
